---
// 灵动云官方站点区块：五个官方站点的固定清单（首页与官方站点说明页共用）。
// 根元素必须保留 data-ldy-family。样式：一张“站点名录”面板，每个站点一行。
import Icon from './Icon.astro';
import { OFFICIAL_SITES, SITE } from '../data/site';

interface Props {
  /** cards：首页名录；rows：文章内的紧凑名录 */
  variant?: 'cards' | 'rows';
  /** 是否在末尾显示“查看官方站点说明”（官方站点说明页本身不显示） */
  showMore?: boolean;
  id?: string;
}
const { variant = 'cards', showMore = true, id = 'sites' } = Astro.props;
const current = 'site';
---
<section class:list={['family', variant === 'cards' ? 'is-cards' : 'is-rows']} data-ldy-family id={id} aria-labelledby={`${id}-title`}>
  <div class="family-head">
    {variant === 'cards' && <span class="eyebrow">官方站点</span>}
    <h2 id={`${id}-title`}>灵动云官方站点</h2>
    <p>灵动云的内容分布在以下五个官方站点，各自负责一件事。</p>
  </div>
  <ol class="family-items">
    {OFFICIAL_SITES.map((s) => (
      <li class:list={['family-item', { current: s.key === current }]}>
        <span class="fi-icon"><Icon name={s.icon} size={20} /></span>
        <span class="fi-text">
          {s.key === current
            ? <span class="fi-name">{s.name}</span>
            : <a class="fi-name" href={s.url}>{s.name}</a>}
          <small class="fi-domain">{s.domain}</small>
          <span class="fi-desc">{s.desc}</span>
        </span>
        {s.key === current
          ? <span class="fi-badge">当前站点</span>
          : <span class="fi-go" aria-hidden="true"><Icon name="external" size={18} /></span>}
      </li>
    ))}
  </ol>
  {showMore && (
    <p class="family-more"><a href={SITE.officialPath}>查看官方站点说明<Icon name="arrow" size={16} /></a></p>
  )}
</section>

<style>
  /* 以 .family 为前缀，保证放进文章 .prose 时不被正文的列表、链接样式覆盖 */
  .family .family-items { list-style: none; padding: 0; margin: 0; }
  .family .family-item { margin: 0; }
  .family .fi-name { color: var(--text); text-decoration: none; }
  .fi-desc { text-wrap: pretty; }

  /* 名录面板 */
  .family-items {
    border: 1px solid var(--line); border-radius: var(--r); overflow: hidden;
    background: linear-gradient(180deg, rgba(22, 15, 43, 0.6), rgba(17, 12, 32, 0.6));
  }
  /* 末列固定宽度（徽标或箭头），保证五行的名称、域名、说明三列上下严格对齐 */
  .family-item {
    position: relative; display: grid; grid-template-columns: 40px minmax(0, 1fr) 80px; align-items: center; gap: 24px;
    padding: 20px 28px; transition: background-color .25s var(--ease);
  }
  .family-item + .family-item { border-top: 1px solid var(--line); }
  .family-item:not(.current):hover { background: rgba(139, 92, 246, 0.06); }
  .family-item:focus-within { background: rgba(139, 92, 246, 0.06); }
  /* 当前站点：左侧一道电光蓝细线 */
  .family-item.current { background: linear-gradient(90deg, rgba(139, 92, 246, 0.1), rgba(139, 92, 246, 0) 60%); }
  .family-item.current::before {
    content: ''; position: absolute; left: 0; top: 14px; bottom: 14px; width: 2px; border-radius: 2px;
    background: var(--accent); box-shadow: 0 0 12px 1px rgba(139, 92, 246, 0.8);
  }

  .fi-icon {
    display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: var(--r-sm);
    border: 1px solid var(--line-2); background: rgba(139, 92, 246, 0.06); color: var(--accent-hi);
  }
  .current .fi-icon { border-color: var(--accent-line); background: rgba(139, 92, 246, 0.16); color: #fff; }

  .fi-text {
    display: grid; grid-template-columns: minmax(150px, 12.5em) minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 24px; align-items: baseline; min-width: 0;
  }
  .fi-name { grid-column: 1; grid-row: 1; font-size: 16.5px; font-weight: 600; line-height: 1.45; }
  a.fi-name::after { content: ''; position: absolute; inset: 0; }
  .family a.fi-name:hover { color: #fff; }
  .fi-domain { grid-column: 1; grid-row: 2; font-size: 13px; font-weight: 500; color: var(--accent-hi); letter-spacing: 0.02em; line-height: 1.5; }
  .fi-desc { grid-column: 2; grid-row: 1 / span 2; align-self: center; font-size: 15px; color: var(--muted); line-height: 1.65; }

  .fi-go { justify-self: end; display: inline-flex; color: var(--faint); transition: color .25s var(--ease), transform .25s var(--ease); }
  .family-item:hover .fi-go { color: var(--accent-hi); transform: translate(2px, -2px); }
  .fi-badge {
    justify-self: end; white-space: nowrap; font-size: 12px; font-weight: 600; line-height: 1.6; color: var(--accent-hi);
    border: 1px solid var(--accent-line); background: rgba(139, 92, 246, 0.1); padding: 2px 10px; border-radius: var(--r-xs);
  }

  .family-more { margin-top: 24px; }
  .family-more a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-weight: 600; }
  .family-more a :global(svg) { transition: transform .25s var(--ease); }
  .family-more a:hover :global(svg) { transform: translateX(3px); }

  /* 首页：左侧标题，右侧名录 */
  .is-cards { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 32px 64px; align-items: start; }
  .is-cards .family-head h2 { font-size: var(--fs-h2); line-height: 1.2; }
  .is-cards .family-head p { color: var(--muted); margin-top: 16px; font-size: 17px; }
  .is-cards .family-more { grid-column: 2; margin-top: -8px; }

  /* 文章内：紧凑名录 */
  .is-rows { margin: 8px 0 2.2em; }
  .is-rows .family-head h2 { font-size: 24px; margin: 1.6em 0 0.5em; line-height: 1.4; }
  .is-rows .family-head p { margin: 0 0 16px; }
  .is-rows .family-item { padding: 16px 20px; gap: 18px; grid-template-columns: 40px minmax(0, 1fr) 72px; }
  .is-rows .fi-text { grid-template-columns: minmax(140px, 10.5em) minmax(0, 1fr); column-gap: 20px; }
  .is-rows .fi-desc { font-size: 14.5px; }
  .is-rows .family-more { margin-top: 16px; }

  @media (max-width: 1100px) {
    .is-cards { grid-template-columns: 1fr; }
    .is-cards .family-more { grid-column: 1; margin-top: 0; }
  }
  @media (max-width: 760px) {
    .family-item, .is-cards .family-item, .is-rows .family-item { grid-template-columns: 40px 1fr; align-items: start; gap: 14px; padding: 18px 16px; }
    .fi-text, .is-rows .fi-text { display: flex; flex-direction: column; }
    .fi-desc, .is-rows .fi-desc { align-self: stretch; margin-top: 6px; font-size: 14.5px; }
    .fi-go { position: absolute; top: 20px; right: 16px; }
    .fi-badge { position: absolute; top: 18px; right: 16px; }
    .family-item.current .fi-name { padding-right: 84px; }
    .family-item:not(.current) .fi-name { padding-right: 28px; }
  }
</style>
