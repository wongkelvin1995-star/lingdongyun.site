---
interface Props { items: { name: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="breadcrumb" aria-label="面包屑导航">
  <ol>
    {items.map((it, i) => (
      <li>
        {it.href && i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .breadcrumb ol { list-style: none; display: flex; flex-wrap: wrap; gap: 4px; padding: 0; margin: 0; font-size: 14px; color: var(--muted); }
  .breadcrumb li { display: inline-flex; align-items: center; min-width: 0; }
  .breadcrumb li + li::before { content: '/'; margin: 0 8px 0 4px; color: #a8c4d8; }
  .breadcrumb a { color: var(--muted); padding: 4px 0; }
  .breadcrumb a:hover { color: var(--primary); }
  .breadcrumb span { color: var(--text); overflow-wrap: anywhere; }
</style>
