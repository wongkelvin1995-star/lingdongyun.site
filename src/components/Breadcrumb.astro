---
interface Props { items: { name: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="breadcrumb" aria-label="面包屑导航">
  <ol>
    {items.map((it, i) => (
      <li>
        {it.href && i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .breadcrumb ol { list-style: none; display: flex; flex-wrap: wrap; gap: 0; padding: 0; margin: 0; font-size: 14px; color: var(--muted); }
  .breadcrumb li { display: inline-flex; align-items: center; min-width: 0; }
  .breadcrumb li + li::before { content: ''; width: 5px; height: 5px; margin: 0 12px 0 10px; border-top: 1px solid var(--faint); border-right: 1px solid var(--faint); transform: rotate(45deg); flex-shrink: 0; }
  .breadcrumb a { display: inline-flex; align-items: center; min-height: 40px; color: var(--muted); }
  .breadcrumb a:hover { color: var(--text); }
  .breadcrumb span { color: var(--text-2); overflow-wrap: anywhere; }
</style>
