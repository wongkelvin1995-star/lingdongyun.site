---
// 灵动云标志组合：图形 + 「灵动云」 + LINGDONG CLOUD。
// 全站所有标志（页头、页脚、404 页的页头页脚）都从这里渲染，图形只来自一个文件：public/brand/logo.svg。
// 以后更换标志，只需替换 public/brand/logo.svg（同时按需替换 favicon 等图标文件）。
import { SITE } from '../data/site';

interface Props {
  /** 图形边长（px），文字大小随之缩放 */
  size?: number;
  /** 是否显示文字部分 */
  text?: boolean;
}
const { size = 32, text = true } = Astro.props;
---
<span class="logo" style={`--logo-size:${size}px`}>
  <img class="logo-mark" src="/brand/logo.svg" width={size} height={size} alt={text ? '' : SITE.brand} decoding="async" />
  {text && (
    <span class="logo-text">
      <span class="logo-name">{SITE.brand}</span>
      <span class="logo-role">{SITE.brandEn}</span>
    </span>
  )}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: calc(var(--logo-size) * 0.34); color: var(--text); }
  .logo-mark {
    width: var(--logo-size); height: var(--logo-size); flex-shrink: 0;
    border-radius: calc(var(--logo-size) * 0.2);
    /* 深色背景上给紫色图形一圈极细的亮边，让它和页面的发丝线语言一致 */
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08), 0 6px 18px -8px rgba(98, 3, 251, 0.7);
  }
  .logo-text { display: flex; flex-direction: column; line-height: 1.1; }
  .logo-name { font-size: calc(var(--logo-size) * 0.56); font-weight: 600; letter-spacing: 0.06em; color: var(--text); }
  .logo-role {
    margin-top: calc(var(--logo-size) * 0.1);
    font-size: max(10.5px, calc(var(--logo-size) * 0.29));
    font-weight: 600; letter-spacing: 0.2em; color: var(--muted);
  }
</style>
