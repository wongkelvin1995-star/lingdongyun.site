<style is:global>
  /* 首页 Hero logo 徽标（源文件 tools/herologo.py） */
  .hl { position: relative; isolation: isolate; }
  .hl svg { display: block; max-width: none; overflow: visible; }
  .hl-front { position: relative; z-index: 2; width: 100%; height: auto; }
  .hl-back, .hl-mark { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hl-back { z-index: 0; }
  .hl-mark { z-index: 4; transform-origin: 50.00% 50.54%; }
  /* 光晕：球体外一圈紫光（CSS 渐变，呼吸时只做合成，不重画） */
  .hl-glow {
    position: absolute; z-index: 0; left: 50%; top: 50%; width: 92%; aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, rgba(139, 92, 246, 0.6), rgba(139, 92, 246, 0.42) 58%, rgba(124, 58, 237, 0.2) 68%, rgba(109, 40, 217, 0.07) 82%, rgba(109, 40, 217, 0));
  }
  .hl-flash {
    position: absolute; z-index: 3; left: 50%; top: 50.5%; width: 50%; aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; pointer-events: none; opacity: 0;
    background: radial-gradient(closest-side, #fff, rgba(235, 221, 255, 0.7) 35%, rgba(167, 139, 250, 0));
  }
  /* 火焰只画在右上方：球体右上缘往上、往右留出空间 */
  .hl-fx { position: absolute; z-index: 1; left: 36%; right: -10%; top: -30%; bottom: 40%; pointer-events: none; }
  .hl-fx canvas { position: absolute; inset: 0; width: 100%; height: 100%; }

  .hl-grid { stroke: #F1E8FF; stroke-width: 1; stroke-opacity: 0.26; }
  .hl-grid .eq { stroke-opacity: 0.5; }
  .hl-grid-back { stroke: #E9D5FF; stroke-width: 1; stroke-opacity: 0.1; }
  .hl-track { fill: none; stroke: #C4B5FD; stroke-opacity: 0.2; stroke-width: 1; }
  .hl-dash { fill: none; stroke: #E4D7FF; stroke-width: 1.6; stroke-linecap: round; }
  .hl-dash.o1 { stroke-dasharray: 3 9; }
  .hl-dash.o2 { stroke-opacity: 0.7; stroke-dasharray: 2 12; }
  .hl-draw { fill: none; stroke: #F5F0FF; stroke-width: 2.4; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 100; opacity: 0; }
  .hl-star-glow { fill: #C084FC; opacity: 0.75; }
  .hl-shine { opacity: 0; }
  .hl-globe { transform-box: fill-box; transform-origin: 50% 50%; }

  /* ---- 出场 + 常驻动效：只在 html.ldy-motion 时播放 ---- */
  html.ldy-motion .hl-stars { animation: hl-fade 1.6s ease 0.1s both; }
  html.ldy-motion .hl-glow { animation: hl-glow-in 1.4s cubic-bezier(.16,1,.3,1) both, hl-breathe 5s ease-in-out 2.4s infinite; }
  html.ldy-motion .hl-globe { animation: hl-globe 1.1s cubic-bezier(.16,1,.3,1) both; }
  html.ldy-motion .hl-track { animation: hl-fade 0.8s ease 0.75s both; }
  html.ldy-motion .hl-dash.o1 { animation: hl-fade 0.8s ease 0.8s both; }
  html.ldy-motion .hl-dash.o2 { animation: hl-fade 0.8s ease 0.9s both; }
  html.ldy-motion .hl-draw { animation: hl-draw 1.25s cubic-bezier(.55,0,.2,1) 0.25s both; }
  html.ldy-motion .hl-draw.d2 { animation-delay: 0.38s; }
  html.ldy-motion .hl-sats { animation: hl-fade 0.6s ease 1.3s both; }
  html.ldy-motion .hl-mark { animation: hl-star 1.15s cubic-bezier(.2,.7,.2,1) 0.55s both, hl-float 7s ease-in-out 2.2s infinite; }
  html.ldy-motion .hl-flash { animation: hl-flash 0.95s ease-out 1.02s both; }
  html.ldy-motion .hl-fx { animation: hl-fade 0.5s ease 1.2s both; }
  /* 轨道虚线流动、logo 扫光要重画 SVG，只在电脑上开 */
  @media (hover: hover) and (pointer: fine) {
    html.ldy-motion .hl-dash.o1 { animation: hl-fade 0.8s ease 0.8s both, hl-orbit 90s linear infinite; }
    html.ldy-motion .hl-dash.o2 { animation: hl-fade 0.8s ease 0.9s both, hl-orbit-2 140s linear infinite reverse; }
    html.ldy-motion .hl-shine { animation: hl-shine 8s cubic-bezier(.45,0,.25,1) 1.75s infinite; }
  }
  /* logo 开场动画播放时先停住，结束后从头开始；徽标滚出屏幕时也暂停 */
  html.ldy-intro .hl, html.ldy-intro .hl *, .hl.is-off, .hl.is-off * { animation-play-state: paused !important; }

  @keyframes hl-fade { from { opacity: 0; } }
  @keyframes hl-glow-in { from { opacity: 0; scale: 0.6; } }
  @keyframes hl-breathe { 50% { opacity: 0.78; scale: 1.035; } }
  @keyframes hl-globe { 0% { opacity: 0; scale: 0.6; } 55% { opacity: 1; } 100% { opacity: 1; scale: 1; } }
  @keyframes hl-draw { 0% { stroke-dashoffset: 100; opacity: 0; } 12% { opacity: 1; } 72% { stroke-dashoffset: 0; opacity: 0.9; } 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes hl-star {
    0% { opacity: 0; scale: 0.2; rotate: -40deg; }
    50% { opacity: 1; }
    70% { scale: 1.1; rotate: 5deg; }
    86% { scale: 0.97; rotate: -1.5deg; }
    100% { opacity: 1; scale: 1; rotate: 0deg; }
  }
  @keyframes hl-flash { 0% { opacity: 0; scale: 0.3; } 30% { opacity: 0.9; } 100% { opacity: 0; scale: 1.6; } }
  @keyframes hl-float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -1.2%; } }
  @keyframes hl-shine { 0% { translate: -780px 0; opacity: 0; } 4% { opacity: 1; } 22% { translate: 780px 0; opacity: 1; } 23%, 100% { translate: 780px 0; opacity: 0; } }
  /* 位移量是虚线周期（12 / 14）的整数倍，循环处无跳动 */
  @keyframes hl-orbit { to { stroke-dashoffset: -1200; } }
  @keyframes hl-orbit-2 { to { stroke-dashoffset: -1400; } }

  @media (forced-colors: active) { .hl-fx, .hl-glow, .hl-flash { display: none; } }
  @media print { .hl-fx, .hl-flash { display: none; } }
</style>
