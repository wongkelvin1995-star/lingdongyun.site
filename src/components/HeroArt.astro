---
// 原创 SVG 场景插画：地球、云、电脑与手机的连接示意。仅为概念示意，并非产品客户端截图。
---
<svg class="hero-art" viewBox="0 0 600 500" width="600" height="500" role="img" aria-labelledby="hero-art-title hero-art-desc">
  <title id="hero-art-title">连接场景示意插画</title>
  <desc id="hero-art-desc">蓝色地球被云朵与轨道环绕，笔记本电脑和手机通过虚线与地球相连，表示多端连接的概念，并非产品界面截图。</desc>
  <defs>
    <radialGradient id="ha-bg" cx="50%" cy="45%" r="55%">
      <stop offset="0" stop-color="#E0F2FE" />
      <stop offset="0.7" stop-color="#F0F9FF" />
      <stop offset="1" stop-color="#FFFFFF" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="ha-globe" cx="38%" cy="32%" r="75%">
      <stop offset="0" stop-color="#7DD3FC" />
      <stop offset="0.45" stop-color="#0EA5E9" />
      <stop offset="1" stop-color="#0369A1" />
    </radialGradient>
    <linearGradient id="ha-land" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#E0F2FE" stop-opacity="0.95" />
      <stop offset="1" stop-color="#BAE6FD" stop-opacity="0.75" />
    </linearGradient>
    <linearGradient id="ha-screen" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0284C7" />
      <stop offset="1" stop-color="#0077B6" />
    </linearGradient>
    <linearGradient id="ha-cloud" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFFFFF" />
      <stop offset="1" stop-color="#E6F4FD" />
    </linearGradient>
    <filter id="ha-shadow" x="-20%" y="-20%" width="140%" height="160%">
      <feDropShadow dx="0" dy="14" stdDeviation="14" flood-color="#0284C7" flood-opacity="0.18" />
    </filter>
    <clipPath id="ha-globe-clip"><circle cx="315" cy="210" r="132" /></clipPath>
  </defs>

  <!-- 背景光晕 -->
  <circle cx="310" cy="235" r="235" fill="url(#ha-bg)" />
  <g fill="#BAE6FD" opacity="0.7">
    <circle cx="96" cy="120" r="3" /><circle cx="530" cy="96" r="4" /><circle cx="560" cy="300" r="3" /><circle cx="70" cy="260" r="2.5" />
  </g>

  <!-- 背后大云 -->
  <g class="ha-float-slow" filter="url(#ha-shadow)">
    <path d="M405 120h96a34 34 0 0 0 4-67.8A48 48 0 0 0 413 60a30 30 0 0 0-8 60Z" fill="url(#ha-cloud)" stroke="#D6EBFA" stroke-width="2" />
  </g>

  <!-- 轨道环（后半） -->
  <ellipse cx="315" cy="214" rx="214" ry="58" transform="rotate(-14 315 214)" fill="none" stroke="#7DD3FC" stroke-width="2" stroke-dasharray="2 9" stroke-linecap="round" opacity="0.9" />

  <!-- 地球 -->
  <g filter="url(#ha-shadow)">
    <circle cx="315" cy="210" r="132" fill="url(#ha-globe)" />
  </g>
  <g clip-path="url(#ha-globe-clip)">
    <path d="M220 120c22-18 52-22 70-12 14 8 8 26-8 30-20 5-22 22-6 34 14 10 4 30-16 30-26 0-46-18-54-40-6-16 0-32 14-42Z" fill="url(#ha-land)" />
    <path d="M330 100c28-6 62 4 80 26 10 12 2 26-14 24-18-2-30 8-24 24 6 18-10 28-26 20-20-10-30-30-34-52-3-20 2-38 18-42Z" fill="url(#ha-land)" />
    <path d="M300 262c20-8 46-2 56 16 8 14-2 34-22 40-22 6-46-2-52-20-5-16 2-30 18-36Z" fill="url(#ha-land)" />
    <path d="M410 214c14-4 30 4 32 18 2 12-8 22-22 22-14 0-24-10-22-22 1-9 4-16 12-18Z" fill="url(#ha-land)" />
    <g fill="none" stroke="#FFFFFF" stroke-opacity="0.32" stroke-width="1.5">
      <ellipse cx="315" cy="210" rx="132" ry="44" />
      <ellipse cx="315" cy="210" rx="132" ry="92" />
      <ellipse cx="315" cy="210" rx="50" ry="132" />
      <ellipse cx="315" cy="210" rx="98" ry="132" />
      <line x1="315" y1="78" x2="315" y2="342" />
      <line x1="183" y1="210" x2="447" y2="210" />
    </g>
    <circle cx="270" cy="160" r="90" fill="#FFFFFF" opacity="0.08" />
  </g>
  <circle cx="315" cy="210" r="132" fill="none" stroke="#FFFFFF" stroke-opacity="0.5" stroke-width="2" />

  <!-- 地球上的节点 -->
  <g>
    <circle cx="262" cy="150" r="10" fill="#FFFFFF" opacity="0.35" /><circle cx="262" cy="150" r="5" fill="#FFFFFF" />
    <circle cx="378" cy="138" r="10" fill="#FFFFFF" opacity="0.35" /><circle cx="378" cy="138" r="5" fill="#FFFFFF" />
    <circle cx="322" cy="290" r="10" fill="#FFFFFF" opacity="0.35" /><circle cx="322" cy="290" r="5" fill="#FFFFFF" />
    <path d="M262 150Q320 112 378 138M378 138Q372 230 322 290M262 150Q270 240 322 290" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-dasharray="4 6" stroke-linecap="round" opacity="0.85" />
  </g>

  <!-- 轨道环（前半）与卫星点 -->
  <path d="M106 268A214 58 -14 0 0 528 160" transform="translate(0 0)" fill="none" stroke="#0284C7" stroke-width="2.5" stroke-linecap="round" opacity="0.55" />
  <circle cx="150" cy="262" r="7" fill="#FFFFFF" stroke="#0284C7" stroke-width="3" />
  <circle cx="505" cy="185" r="6" fill="#0284C7" />

  <!-- 左侧小云 -->
  <g class="ha-float">
    <path d="M90 196h64a22 22 0 0 0 2-43.9A31 31 0 0 0 96 156a20 20 0 0 0-6 40Z" fill="url(#ha-cloud)" stroke="#D6EBFA" stroke-width="2" filter="url(#ha-shadow)" />
  </g>

  <!-- 连接虚线：电脑 → 地球，手机 → 地球 -->
  <path d="M175 330C190 290 210 280 235 268" fill="none" stroke="#0284C7" stroke-width="2.5" stroke-dasharray="5 7" stroke-linecap="round" />
  <path d="M470 300C468 280 455 268 432 258" fill="none" stroke="#0284C7" stroke-width="2.5" stroke-dasharray="5 7" stroke-linecap="round" />
  <circle cx="235" cy="268" r="5" fill="#0077B6" /><circle cx="432" cy="258" r="5" fill="#0077B6" />

  <!-- 笔记本电脑 -->
  <g filter="url(#ha-shadow)">
    <rect x="58" y="320" width="220" height="138" rx="12" fill="#0F3B57" />
    <rect x="68" y="330" width="200" height="118" rx="6" fill="url(#ha-screen)" />
    <path d="M36 458h264l-14 18a8 8 0 0 1-6.3 3H56.3a8 8 0 0 1-6.3-3Z" fill="#CFE6F5" />
    <rect x="140" y="458" width="56" height="6" rx="3" fill="#A5CDE6" />
  </g>
  <!-- 屏幕内抽象图形（示意，非真实界面） -->
  <g>
    <circle cx="118" cy="389" r="30" fill="none" stroke="#FFFFFF" stroke-opacity="0.35" stroke-width="2" />
    <circle cx="118" cy="389" r="18" fill="#FFFFFF" fill-opacity="0.2" />
    <path d="M108 389l7 7 13-14" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    <rect x="162" y="364" width="84" height="8" rx="4" fill="#FFFFFF" fill-opacity="0.85" />
    <rect x="162" y="381" width="62" height="7" rx="3.5" fill="#FFFFFF" fill-opacity="0.45" />
    <rect x="162" y="398" width="74" height="7" rx="3.5" fill="#FFFFFF" fill-opacity="0.45" />
    <rect x="162" y="415" width="48" height="7" rx="3.5" fill="#FFFFFF" fill-opacity="0.45" />
  </g>

  <!-- 手机 -->
  <g filter="url(#ha-shadow)">
    <rect x="432" y="296" width="96" height="176" rx="18" fill="#0F3B57" />
    <rect x="440" y="306" width="80" height="156" rx="12" fill="#FFFFFF" />
    <rect x="466" y="312" width="28" height="5" rx="2.5" fill="#CFE6F5" />
  </g>
  <g>
    <circle cx="480" cy="364" r="24" fill="#F0F9FF" stroke="#7DD3FC" stroke-width="2" />
    <circle cx="480" cy="364" r="14" fill="#0077B6" />
    <path d="M480 356v9" stroke="#FFFFFF" stroke-width="2.6" stroke-linecap="round" />
    <path d="M473.5 359.5a9 9 0 1 0 13 0" fill="none" stroke="#FFFFFF" stroke-width="2.4" stroke-linecap="round" />
    <rect x="452" y="402" width="56" height="7" rx="3.5" fill="#BAE6FD" />
    <rect x="452" y="417" width="40" height="7" rx="3.5" fill="#E0F2FE" />
    <rect x="452" y="432" width="48" height="7" rx="3.5" fill="#E0F2FE" />
  </g>
</svg>

<style>
  .hero-art { width: 100%; height: auto; overflow: visible; }
  .ha-float { animation: ha-float 7s ease-in-out infinite; }
  .ha-float-slow { animation: ha-float 9s ease-in-out infinite reverse; }
  @keyframes ha-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  @media (prefers-reduced-motion: reduce) { .ha-float, .ha-float-slow { animation: none; } }
</style>
