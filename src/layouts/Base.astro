---
import '../styles/global.css';
// 自托管 Manrope（@fontsource-variable/manrope，只用拉丁子集约 25 KB）：拉丁字母与数字的展示字体，中文走系统字体
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import GlobalNav from '../components/GlobalNav.astro';
import MotionHead from '../components/MotionHead.astro';
import MotionIntro from '../components/MotionIntro.astro';
import MotionReveal from '../components/MotionReveal.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { siteNodes, type Node } from '../data/jsonld';

// 只覆盖拉丁字母、数字与常用符号；中文引号、破折号、省略号留给中文字体
const fontFace = `@font-face{font-family:'Manrope Variable';font-style:normal;font-display:swap;font-weight:200 800;src:url(${manropeLatin}) format('woff2-variations'),url(${manropeLatin}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-2013,U+2020-2022,U+2030,U+2039-203A,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215}`;

interface Props {
  title: string;
  description: string;
  /** 站内路径，如 /guides/ ；用于 canonical 与 og:url */
  path: string;
  ogType?: 'website' | 'article';
  /** 本页的结构化数据节点（不含 @context），与全站 Organization / WebSite 节点合并为一个 @graph */
  jsonLd?: Node[];
  noindex?: boolean;
  article?: { published: string; updated: string };
}

const { title, description, path, ogType = 'website', jsonLd = [], noindex = false, article } = Astro.props;
const canonical = new URL(path, SITE.url).href;
// v=3：2026-11-01 换成官方标志后重新生成了分享图与图标，更新版本号让缓存刷新
const ogImage = new URL(SITE.ogImage, SITE.url).href + '?v=3';
const graph = { '@context': 'https://schema.org', '@graph': [...siteNodes(), ...jsonLd] };
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 出场动态：判断是否播放 + 样式（tools/motion.py） -->
    <MotionHead />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#07050F" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFace} />
    <link rel="icon" href="/favicon.ico?v=3" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png?v=3" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="灵动云官网 LINGDONG CLOUD 分享图" />
    {article && <meta property="article:published_time" content={article.published} />}
    {article && <meta property="article:modified_time" content={article.updated} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <!-- 悬停或按下链接时预先加载同站页面，点击后打开更快（只在支持的浏览器生效） -->
    <script type="speculationrules" is:inline set:html={"{\"prefetch\":[{\"where\":{\"and\":[{\"href_matches\":\"/*\"},{\"not\":{\"selector_matches\":\"[target=_blank], [download], [rel~=nofollow]\"}}]},\"eagerness\":\"moderate\"}]}"}></script>
  </head>
  <body>
    <MotionIntro />
    <a class="skip-link" href="#main">跳到主要内容</a>
    <GlobalNav />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MotionReveal />
  </body>
</html>
