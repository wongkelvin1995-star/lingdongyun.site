---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { OFFICIAL_SITES } from '../../data/site';
import { breadcrumbs } from '../../data/jsonld';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const title = '灵动云官网网站地图：本站页面与五个官方站点入口';
const description = '灵动云官网的页面索引：首页的套餐价格、服务说明、官方站点与常见问题板块，官网资料里的官方站点说明和套餐价格与服务说明，以及灵动云五个官方站点的首页入口。';
const jsonLd = [
  breadcrumbs([
    { name: '首页', path: '/' },
    { name: '网站地图', path: '/sitemap/' },
  ]),
];
---
<Base title={title} description={description} path="/sitemap/" jsonLd={jsonLd}>
  <div class="sm container">
    <Breadcrumb items={[{ name: '首页', href: '/' }, { name: '网站地图' }]} />
    <h1>网站地图</h1>
    <p class="sm-lead">灵动云官网的全部页面，以及五个官方站点的入口。</p>
    <div class="cols">
      <section aria-labelledby="sm-home">
        <h2 id="sm-home">官网首页</h2>
        <ul>
          <li><a href="/">灵动云官网首页</a></li>
          <li><a href="/#pricing">9 档套餐与价格</a></li>
          <li><a href="/#service">服务说明</a></li>
          <li><a href="/#sites">灵动云官方站点</a></li>
          <li><a href="/#faq">常见问题</a></li>
        </ul>
      </section>
      <section aria-labelledby="sm-guides">
        <h2 id="sm-guides">官网资料</h2>
        <ul>
          <li><a href="/guides/">官网资料目录</a></li>
          {guides.map((g) => <li><a href={`/guides/${g.id}/`}>{g.data.title}</a></li>)}
        </ul>
      </section>
      <section aria-labelledby="sm-sites">
        <h2 id="sm-sites">五个官方站点</h2>
        <ul>
          {OFFICIAL_SITES.map((s) => (
            <li><a href={s.url}>{s.name}</a><small>{s.domain}</small></li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Base>
<style>
  .sm { padding-top: 32px; padding-bottom: 104px; }
  h1 { margin-top: 24px; font-size: clamp(32px, 4.4vw, 52px); line-height: 1.15; letter-spacing: 0.02em; }
  .sm-lead { margin-top: 14px; font-size: 17px; color: var(--muted); }
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 40px; }
  section {
    padding: 28px 28px 20px; border: 1px solid var(--line); border-radius: var(--r);
    background: linear-gradient(180deg, rgba(22, 15, 43, 0.6), rgba(17, 12, 32, 0.6));
  }
  h2 { display: flex; align-items: center; gap: 10px; font-size: 18px; }
  h2::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--accent-hi); box-shadow: 0 0 0 3px rgba(196, 181, 253, 0.16), 0 0 10px 1px rgba(196, 181, 253, 0.55); }
  ul { list-style: none; margin: 14px 0 0; padding: 0; }
  li { margin: 0; border-top: 1px solid var(--line); }
  li a { display: inline-flex; align-items: center; min-height: 44px; padding: 6px 0; line-height: 1.5; color: var(--text-2); }
  li a:hover { color: #fff; }
  li small { margin-left: 10px; font-size: 13px; color: var(--accent-hi); }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr; gap: 16px; } section { padding: 22px 20px 14px; } }
</style>
