---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Icon from '../../components/Icon.astro';
import { SITE, readMinutes } from '../../data/site';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const title = '使用指南：机场选购与 Clash 客户端知识｜灵动云官网';
const description = '灵动云使用指南：便宜机场、安全机场、2026 机场推荐的判断方法，稳定节点观察指标，以及 Clash、Clash Party 订阅导入与维护。';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: '灵动云使用指南',
    url: `${SITE.url}/guides/`,
    inLanguage: 'zh-CN',
    hasPart: guides.map((g) => ({ '@type': 'BlogPosting', headline: g.data.title, url: `${SITE.url}/guides/${g.id}/` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: '使用指南', item: `${SITE.url}/guides/` },
    ],
  },
];
---
<Base title={title} description={description} path="/guides/" jsonLd={jsonLd}>
  <div class="list-hero">
    <div class="container">
      <Breadcrumb items={[{ name: '首页', href: '/' }, { name: '使用指南' }]} />
      <h1>使用指南</h1>
      <p>机场选购与客户端知识：先讲判断方法，再讲具体操作。共 {guides.length} 篇。</p>
    </div>
  </div>
  <div class="container list-body">
    <ul class="g-list">
      {guides.map((g) => (
        <li class="card">
          <div class="g-top">
            <span class="g-cat">{g.data.category}</span>
            <span>约 {readMinutes(g.body)} 分钟 · <time datetime={g.data.updated}>更新于 {g.data.updated}</time></span>
          </div>
          <h2><a href={`/guides/${g.id}/`}>{g.data.title}</a></h2>
          <p>{g.data.excerpt}</p>
          <span class="g-more" aria-hidden="true">阅读全文<Icon name="arrow" size={16} /></span>
        </li>
      ))}
    </ul>
    <div class="list-cta">
      <a class="btn btn-outline" href="/">返回首页</a>
      <a class="btn btn-primary" href="/#pricing">查看套餐<Icon name="arrow" size={18} /></a>
    </div>
  </div>
</Base>
<style>
  .list-hero { background: linear-gradient(180deg, var(--soft), #fff); padding: 36px 0 40px; border-bottom: 1px solid #e8f3fb; }
  .list-hero h1 { font-size: clamp(30px, 4vw, 42px); margin-top: 20px; }
  .list-hero p { color: var(--muted); margin-top: 10px; font-size: 17px; }
  .list-body { padding: 48px var(--gutter) 88px; }
  .g-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .g-list li { position: relative; padding: 28px; display: flex; flex-direction: column; transition: transform .25s, box-shadow .25s, border-color .25s; }
  .g-list li:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); border-color: #bfe0f5; }
  .g-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 13px; color: var(--muted); }
  .g-cat { font-weight: 700; color: var(--primary); background: var(--soft); padding: 3px 10px; border-radius: 6px; }
  .g-list h2 { font-size: 20px; margin-top: 14px; line-height: 1.45; }
  .g-list h2 a { color: var(--text); }
  .g-list h2 a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
  .g-list h2 a:hover { color: var(--primary); }
  .g-list p { color: var(--muted); margin-top: 10px; flex: 1; }
  .g-more { display: inline-flex; align-items: center; gap: 4px; margin-top: 16px; font-size: 14px; font-weight: 600; color: var(--primary); }
  .list-cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 48px; }
  @media (max-width: 760px) { .g-list { grid-template-columns: 1fr; } .g-list li { padding: 22px; } }
</style>
