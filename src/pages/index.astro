---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroArt from '../components/HeroArt.astro';
import Icon from '../components/Icon.astro';
import { REVIEWS } from '../data/reviews';
import { FAQS, PLANS, PLAN_FILTERS, PLAN_NOTE, SITE, readMinutes } from '../data/site';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);

const title = '灵动云官网 - 灵动云机场 Lingdongyun｜2026 机场推荐与套餐价格';
const description =
  '灵动云官网（lingdongyun.site）：灵动云机场提供 8 档套餐，月付 ¥20 起、年付 ¥99（每月 70GB）、一次性流量包 150GB–800GB 总流量，并附灵动云 VPN 客户端配置、Clash 订阅导入与机场选购指南。';

const planBy = (name: string) => PLANS.find((p) => p.name === name)!;
const scenarios = [
  { icon: 'leaf', title: '轻度浏览，长期使用', text: '主要查资料、看网页、收发消息，每月用量不大，希望一次付清、省心用一年。', plan: planBy('灵动·穿云') },
  { icon: 'globe', title: '刚开始尝试', text: '第一次使用，还不清楚自己每月用多少流量，想先用小档位熟悉一下。', plan: planBy('灵动·拂风') },
  { icon: 'play', title: '每天看视频', text: '日常追剧、刷视频、听音乐，使用频率高，需要更充足的每月流量。', plan: planBy('灵动·驭浪') },
  { icon: 'monitor', title: '高清内容与多设备', text: '经常观看高清视频，或者电脑、手机多台设备一起使用同一个套餐。', plan: planBy('灵动·破晓') },
  { icon: 'zap', title: '重度使用', text: '长时间在线、经常下载大文件，每月流量需求很大。', plan: planBy('灵动·凌霄') },
  { icon: 'briefcase', title: '偶尔出差或短期项目', text: '平时很少用，只在出差、旅行或短期项目时集中使用，不想按月付费。', plan: planBy('灵动·闲云'), note: '用量更大可选灵动·惊云（400GB）或灵动·飞云（800GB）' },
] as const;

const features = [
  { icon: 'layers', title: '按需选购', text: '从月付到流量包，选择适合自己的节奏。', href: '/guides/plan-selection/' },
  { icon: 'devices', title: '多端指南', text: '了解 Clash 与 Clash Party 等客户端的使用知识。', href: '/guides/multi-device-clients/' },
  { icon: 'compass', title: '清楚上手', text: '套餐、订阅与节点，一站了解。', href: '/guides/getting-started/' },
] as const;

const org = {
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.brand,
  alternateName: [...SITE.aliases],
  description: SITE.description,
  url: `${SITE.url}/`,
  logo: `${SITE.url}/logo-512.png`,
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        ...org,
        hasOfferCatalog: {
          '@type': 'OfferCatalog',
          name: '灵动云套餐',
          itemListElement: PLANS.map((p) => ({
            '@type': 'Offer',
            name: p.name,
            price: p.price.toFixed(2),
            priceCurrency: 'CNY',
            category: p.categoryLabel,
            description: `${p.categoryLabel}，¥${p.price} ${p.billing}，${p.traffic}`,
            url: SITE.registerUrl,
            itemOffered: { '@type': 'Service', name: p.name },
          })),
        },
      },
      {
        '@type': 'WebSite',
        '@id': `${SITE.url}/#website`,
        name: SITE.name,
        alternateName: ['灵动云', 'Lingdongyun', 'LINGDONG CLOUD'],
        url: `${SITE.url}/`,
        inLanguage: 'zh-CN',
        publisher: { '@id': `${SITE.url}/#organization` },
      },
      {
        '@type': 'FAQPage',
        '@id': `${SITE.url}/#faq`,
        mainEntity: FAQS.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      },
    ],
  },
];
---
<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  <meta slot="head" name="keywords" content="灵动云,灵动云官网,灵动云机场,灵动云VPN,lingdongyun,LINGDONG CLOUD,机场推荐 2026" />
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker"><span class="dot" aria-hidden="true"></span>LINGDONG CLOUD · 灵动云官网</p>
        <h1>连接世界，<br /><span class="accent">灵动随行。</span></h1>
        <p class="hero-lead">灵动云机场提供月付、年付与一次性流量套餐，先比较付款周期，再按预算和用量选择。结合套餐价格说明、Clash订阅导入与小火箭使用指南，了解流量规划和客户端配置，让科学上网从选套餐到首次连接都有清晰参考。</p>
        <ul class="hero-points">
          <li><Icon name="check" size={18} />灵活套餐</li>
          <li><Icon name="check" size={18} />多端指南</li>
          <li><Icon name="check" size={18} />清晰上手</li>
        </ul>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#pricing">查看套餐<Icon name="arrow" size={18} /></a>
          <a class="btn btn-outline" href="/guides/">阅读使用指南</a>
        </div>
      </div>
      <div class="hero-visual">
        <HeroArt />
      </div>
    </div>
  </section>

  <!-- 服务优势 -->
  <section class="section" id="features" aria-labelledby="features-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">服务优势</span>
        <h2 id="features-title">让连接的每一步，都更清楚</h2>
      </div>
      <div class="feature-grid">
        {features.map((f) => (
          <article class="feature card">
            <span class="feature-icon"><Icon name={f.icon} size={28} /></span>
            <h3><a href={f.href}>{f.title}</a></h3>
            <p>{f.text}</p>
            <span class="feature-more" aria-hidden="true">阅读详细指南<Icon name="arrow" size={16} /></span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 关于灵动云 -->
  <section class="section about" id="about" aria-labelledby="about-title">
    <div class="container about-grid">
      <div class="about-copy">
        <span class="eyebrow">关于灵动云</span>
        <h2 id="about-title">灵动云是什么？</h2>
        <p><strong>灵动云</strong>（LINGDONG CLOUD，拼音 lingdongyun）是一个提供代理节点订阅的机场服务品牌，<strong>灵动云官网</strong>为 lingdongyun.site。网上常说的“灵动云机场”“灵动云VPN”，指的都是这个品牌。</p>
        <p>灵动云提供月付、年付与一次性流量包三类套餐，订阅可配合 Clash、Clash Party、小火箭等客户端使用；注册、购买与订阅管理通过官网按钮进入的官方账户平台完成。</p>
        <a class="about-link" href="/guides/lingdongyun-official/">了解官方网址、注册入口与防仿冒方法<Icon name="arrow" size={16} /></a>
      </div>
      <dl class="about-facts card">
        <div><dt>品牌名称</dt><dd>灵动云 · LINGDONG CLOUD</dd></div>
        <div><dt>官方网址</dt><dd>lingdongyun.site</dd></div>
        <div><dt>常见叫法</dt><dd>灵动云机场、灵动云VPN、灵动云官网</dd></div>
        <div><dt>套餐类型</dt><dd>月付 ¥20 起 · 年付 ¥99 · 一次性流量包</dd></div>
        <div><dt>适用客户端</dt><dd>Clash、Clash Party、小火箭等（以订阅格式为准）</dd></div>
        <div><dt>注册入口</dt><dd><a href={SITE.registerUrl} target="_blank" rel="noopener">官方账户平台</a></dd></div>
      </dl>
    </div>
  </section>

  <!-- 套餐价格 -->
  <section class="section section-soft" id="pricing" aria-labelledby="pricing-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">套餐价格</span>
        <h2 id="pricing-title">找到适合你的那一款</h2>
        <p>月付、年付与一次性流量包，按需选择。</p>
      </div>

      <div class="plan-filter" role="group" aria-label="按套餐类型筛选" data-plan-filter>
        {PLAN_FILTERS.map((f, i) => (
          <button type="button" class="filter-btn" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
        ))}
      </div>
      <p class="sr-only" aria-live="polite" data-plan-status></p>

      <ul class="plan-grid" data-plan-grid>
        {PLANS.map((p) => (
          <li class:list={['plan card', { featured: p.badge }]} data-category={p.category}>
            <div class="plan-top">
              <span class="plan-cat">{p.categoryLabel}</span>
              {p.badge && <span class="plan-badge">{p.badge}</span>}
            </div>
            <h3 class="plan-name">{p.name}</h3>
            <p class="plan-price"><span class="cur">¥</span><span class="num">{p.price}</span><span class="bill">{p.billing}</span></p>
            <p class="plan-traffic">{p.traffic}</p>
            <p class="plan-hint">
              {p.category === 'monthly' && '按月计费，每月对应流量'}
              {p.category === 'yearly' && '全年费用 ¥99，每月 70GB'}
              {p.category === 'onetime' && '一次性支付，享有总流量'}
            </p>
            <a class:list={['btn', p.badge ? 'btn-primary' : 'btn-outline', 'plan-btn']} href={SITE.registerUrl} target="_blank" rel="noopener" aria-label={`选择此套餐：${p.name}`}>选择此套餐</a>
          </li>
        ))}
      </ul>
      <p class="plan-note">{PLAN_NOTE}</p>
    </div>
  </section>

  <!-- 教学指南 -->
  <section class="section section-guides" id="guides" aria-labelledby="guides-title">
    <div class="container">
      <div class="section-head">
        <span class="pill">官方知识库 · 新手教程与节点科普</span>
        <h2 id="guides-title" class="guides-title">灵动云 <span>使用教程与网络指南</span></h2>
        <p>选得明白，用得顺手：从机场选购、节点稳定性判断、订阅安全，到 Clash 与 Clash Party 客户端的导入、更新和排错，一站读懂。</p>
      </div>
      <ul class="guide-grid">
        {guides.map((g) => (
          <li class="guide card">
            <div class="guide-top">
              <span class="guide-cat">{g.data.category}</span>
              <span class="guide-time">约 {readMinutes(g.body)} 分钟</span>
            </div>
            <h3><a href={`/guides/${g.id}/`}>{g.data.title}</a></h3>
            <p>{g.data.excerpt}</p>
            <span class="guide-more" aria-hidden="true"><span>阅读完整指南</span><Icon name="arrow" size={18} /></span>
          </li>
        ))}
      </ul>
      <div class="center-cta">
        <a class="btn btn-outline" href="/guides/"><Icon name="book" size={18} />查看全部指南</a>
      </div>
    </div>
  </section>

  <!-- 适用场景 -->
  <section class="section section-soft" id="scenarios" aria-labelledby="scenarios-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">适用场景</span>
        <h2 id="scenarios-title">你属于哪一类用户？</h2>
        <p>对照自己的使用习惯，找到更合适的套餐。</p>
      </div>
      <ul class="scene-grid">
        {scenarios.map((sc) => (
          <li class:list={['scene card', { featured: sc.plan.badge }]}>
            <div class="scene-head">
              <span class="scene-icon"><Icon name={sc.icon} size={24} /></span>
              <h3>{sc.title}</h3>
            </div>
            <p class="scene-text">{sc.text}</p>
            <div class="scene-plan">
              <span class="scene-label">推荐套餐</span>
              <div class="scene-row">
                <strong>{sc.plan.name}</strong>
                {sc.plan.badge && <span class="plan-badge">{sc.plan.badge}</span>}
              </div>
              <p class="scene-price"><span>¥{sc.plan.price}</span> {sc.plan.billing} · {sc.plan.traffic}</p>
              {'note' in sc && sc.note && <p class="scene-note">{sc.note}</p>}
            </div>
            <a class:list={['btn', sc.plan.badge ? 'btn-primary' : 'btn-outline', 'scene-btn']} href={SITE.registerUrl} target="_blank" rel="noopener" aria-label={`选择此套餐：${sc.plan.name}`}>选择此套餐</a>
          </li>
        ))}
      </ul>
      <p class="plan-note">场景仅供参考，请按自己的实际用量选择；套餐信息以注册后台实际展示为准。不确定怎么选？阅读<a href="/guides/plan-selection/">灵动云套餐怎么选</a>。</p>
    </div>
  </section>

  {REVIEWS.length > 0 && (
  <!-- 用户评价：仅在 src/data/reviews.ts 中有真实授权评价时显示 -->
  <section class="section" id="reviews" aria-labelledby="reviews-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">用户声音</span>
        <h2 id="reviews-title">用户评价</h2>
      </div>
      <ul class="review-grid">
        {REVIEWS.map((r) => (
          <li class="review card">
            <div class="stars" role="img" aria-label={`${r.rating} 星（满分 5 星）`}>
              {[1, 2, 3, 4, 5].map((i) => (
                <svg class:list={['star', { off: i > r.rating }]} viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 1.8l2.5 5.2 5.7.8-4.1 4 1 5.6L10 14.7l-5.1 2.7 1-5.6-4.1-4 5.7-.8L10 1.8z" /></svg>
              ))}
            </div>
            <blockquote>{r.content}</blockquote>
            <div class="review-meta">
              <span class="avatar" aria-hidden="true">{r.name.slice(0, 1)}</span>
              <span class="who"><strong>{r.name}</strong>{r.plan && <small>{r.plan}</small>}</span>
              <time datetime={r.date}>{r.date}</time>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
  )}

  <!-- FAQ -->
  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="container faq-wrap">
      <div class="section-head">
        <span class="eyebrow">FAQ</span>
        <h2 id="faq-title">常见问题</h2>
        <p>关于套餐、注册、客户端与订阅安全的说明。</p>
      </div>
      <div class="faq-list">
        {FAQS.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary><h3>{f.q}</h3><span class="faq-icon" aria-hidden="true"><Icon name="plus" size={20} /></span></summary>
            <div class="faq-a"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
      <div class="faq-cta card">
        <div>
          <p class="faq-cta-title">准备好开始了吗？</p>
          <p class="faq-cta-text">在灵动云账户平台完成注册，并查看套餐的实际展示信息。</p>
        </div>
        <a class="btn btn-primary" href={SITE.registerUrl} target="_blank" rel="noopener">立即注册</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const group = document.querySelector<HTMLElement>('[data-plan-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-plan-grid] > li');
  const status = document.querySelector<HTMLElement>('[data-plan-status]');
  if (group) {
    group.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
      if (!btn) return;
      const key = btn.dataset.filter;
      group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let n = 0;
      cards.forEach((c) => {
        const show = key === 'all' || c.dataset.category === key;
        c.hidden = !show;
        if (show) n++;
      });
      if (status) status.textContent = `${btn.textContent}：共 ${n} 个套餐`;
    });
  }
</script>

<style>
  /* Hero */
  .hero { position: relative; padding: 56px 0 24px; overflow: hidden;
    background: radial-gradient(1200px 500px at 85% -10%, #e0f2fe 0%, rgba(240, 249, 255, 0) 60%), #fff; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1.05fr; align-items: center; gap: 40px; }
  .hero-kicker { display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 700; letter-spacing: .12em; color: var(--primary);
    background: var(--soft); border: 1px solid var(--border); padding: 6px 14px; border-radius: 999px; }
  .hero-kicker .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--primary-2); box-shadow: 0 0 0 4px rgba(2, 132, 199, .15); }
  .hero h1 { font-size: clamp(40px, 5.6vw, 66px); font-weight: 800; margin-top: 22px; line-height: 1.18; letter-spacing: .02em; }
  .hero h1 .accent { color: var(--primary); }
  .hero-lead { font-size: clamp(16px, 1.35vw, 18px); line-height: 1.85; color: var(--muted); margin-top: 20px; max-width: 34em; }
  @media (max-width: 900px) { .hero-lead { margin-left: auto; margin-right: auto; text-align: left; } }
  .hero-points { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-wrap: wrap; gap: 10px 22px; }
  .hero-points li { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: #1e3a52; }
  .hero-points li :global(svg) { color: #fff; background: var(--primary-2); border-radius: 50%; padding: 3px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }
  .hero-visual { max-width: 600px; justify-self: end; width: 100%; }

  /* Features */
  .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .feature { position: relative; display: flex; flex-direction: column; padding: 32px 28px 26px; transition: transform .25s, box-shadow .25s, border-color .25s; }
  .feature:focus-within { border-color: var(--primary-2); }
  .feature h3 a { color: var(--text); }
  .feature h3 a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
  .feature:hover h3 a { color: var(--primary); }
  .feature p { flex: 1; }
  .feature-more { display: inline-flex; align-items: center; gap: 4px; margin-top: 18px; font-size: 14.5px; font-weight: 600; color: var(--primary); }
  .feature-more :global(svg) { transition: transform .2s; }
  .feature:hover .feature-more :global(svg) { transform: translateX(3px); }
  .feature:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .feature-icon { display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: 16px;
    background: var(--soft); color: var(--primary); border: 1px solid var(--border); }
  .feature h3 { font-size: 20px; margin-top: 20px; }
  .feature p { color: var(--muted); margin-top: 8px; }

  /* Pricing */
  .plan-filter { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-bottom: 36px; }
  .filter-btn { min-height: 44px; padding: 0 22px; border-radius: 999px; border: 1px solid var(--border); background: #fff; color: #334155;
    font: inherit; font-size: 15px; font-weight: 600; cursor: pointer; transition: all .2s; }
  .filter-btn:hover { border-color: var(--primary-2); color: var(--primary); }
  .filter-btn[aria-pressed='true'] { background: var(--primary); border-color: var(--primary); color: #fff; box-shadow: 0 6px 16px rgba(0, 119, 182, .22); }
  .plan-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .plan { position: relative; display: flex; flex-direction: column; padding: 26px 24px 24px; transition: transform .25s, box-shadow .25s, border-color .25s; }
  .plan[hidden] { display: none; }
  .plan:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: #bfe0f5; }
  .plan.featured { border: 2px solid var(--primary); padding: 25px 23px 23px; box-shadow: var(--shadow-lg); }
  .plan-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; min-height: 26px; }
  .plan-cat { font-size: 13px; font-weight: 600; color: var(--primary); background: var(--soft); border: 1px solid var(--border); padding: 2px 10px; border-radius: 999px; }
  .plan-badge { font-size: 12.5px; font-weight: 700; color: #fff; background: var(--primary); padding: 3px 10px; border-radius: 999px; }
  .plan-name { font-size: 20px; margin-top: 16px; }
  .plan-price { display: flex; align-items: baseline; gap: 2px; margin-top: 14px; color: var(--text); }
  .plan-price .cur { font-size: 20px; font-weight: 700; color: var(--primary); }
  .plan-price .num { font-size: 40px; font-weight: 800; color: var(--primary); line-height: 1; letter-spacing: -0.01em; }
  .plan-price .bill { font-size: 15px; color: var(--muted); margin-left: 6px; }
  .plan-traffic { margin-top: 16px; padding-top: 16px; border-top: 1px dashed var(--border); font-size: 18px; font-weight: 700; }
