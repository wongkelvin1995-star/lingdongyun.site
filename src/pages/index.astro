---
import FlameTitle from '../components/FlameTitle.astro';
import FlameScript from '../components/FlameScript.astro';
import Base from '../layouts/Base.astro';
import HeroLogo from '../components/HeroLogo.astro';
import Icon from '../components/Icon.astro';
import { COMMON_FACTS, FAQS, PLANS, PLAN_FILTERS, PLAN_NOTE, SITE, perMonth, saving, yuan } from '../data/site';
import { faqPage, planCatalog } from '../data/jsonld';

const title = '灵动云官网｜灵动云机场套餐价格与注册入口（Lingdongyun）';
const description = SITE.description;
const home = `${SITE.url}/`;

const regular = PLANS.filter((p) => p.category !== 'custom');
const custom = PLANS.find((p) => p.category === 'custom')!;
const ext = (external?: boolean) => (external ? { target: '_blank', rel: 'noopener' } : {});

// Hero 下方的事实条：只列 SPEC §2 中的真实信息
const FACTS = [
  { icon: 'tag', text: '9 档透明定价' },
  { icon: 'gauge', text: '不限速' },
  { icon: 'devices', text: '不限设备' },
  { icon: 'route', text: 'IEPL / IPLC 优化线路' },
  { icon: 'chat', text: '用户中心工单' },
] as const;

const jsonLd = [planCatalog(home), faqPage(home, FAQS)];
---
<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  <!-- Hero：官网是什么、这里能找到什么 -->
  <section class="hero">
    <div class="hero-sky" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker"><span class="dot" aria-hidden="true"></span>LINGDONG CLOUD</p>
        <h1><span class="h1-name"><FlameTitle text="灵动云官网" /></span><span class="h1-tag">连接世界，<span class="accent">灵动随行。</span></span></h1>
        <p class="hero-lead">灵动云（Lingdongyun）是提供代理节点订阅（俗称“机场”）的网络服务品牌，lingdongyun.site 是它的官网。这一页列出全部 9 档套餐的价格与流量、所有套餐共用的服务规则和注册入口：月付 <span class="nw">¥20/月起</span>，年付 <span class="nw">¥99/年</span>，一次性流量包 <span class="nw">¥199 起</span>，另有至尊私人定制；不限速、不限设备，使用 <span class="nw">IEPL / IPLC</span> 优化线路。</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={SITE.registerUrl} target="_blank" rel="noopener">注册账号</a>
          <a class="btn btn-outline" href="#pricing">查看 9 档套餐</a>
        </div>
      </div>
      <div class="hero-visual">
        <HeroLogo />
      </div>
    </div>
    <div class="container">
      <ul class="facts">
        {FACTS.map((f) => (
          <li><Icon name={f.icon} size={18} /><span>{f.text}</span></li>
        ))}
      </ul>
    </div>
  </section>
  <FlameScript />

  <!-- 9 档套餐 -->
  <section class="section section-soft pricing" id="pricing" aria-labelledby="pricing-title">
    <div class="container">
      <div class="pricing-top">
        <div class="section-head">
          <span class="eyebrow">套餐价格</span>
          <h2 id="pricing-title">9 档套餐与价格</h2>
          <p>月付 4 档、年付 1 档、一次性流量包 3 档，另有 1 档至尊私人定制。</p>
        </div>
        <div class="plan-filter" role="group" aria-label="按套餐类型筛选" data-plan-filter>
          {PLAN_FILTERS.map((f, i) => (
            <button type="button" class="filter-btn" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
          ))}
        </div>
      </div>
      <p class="sr-only" aria-live="polite" data-plan-status></p>

      <!-- 8 档常规套餐：一排横向排开，手机左右滑、电脑点箭头或拖动触控板 -->
      <div class="rail" data-rail>
        <div class="rail-bar">
          <p class="rail-hint"><span class="rail-hint-touch">左右滑动查看全部套餐</span><span class="rail-hint-mouse">左右滚动查看全部套餐</span></p>
          <div class="rail-nav">
            <button type="button" class="rail-btn" data-rail-prev aria-label="向左查看上一组套餐" disabled>
              <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><path d="M12.5 4.5 7 10l5.5 5.5" /></svg>
            </button>
            <button type="button" class="rail-btn" data-rail-next aria-label="向右查看下一组套餐">
              <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><path d="M7.5 4.5 13 10l-5.5 5.5" /></svg>
            </button>
          </div>
        </div>
        <ul class="plan-grid" data-plan-grid tabindex="0" aria-label="套餐卡片（可左右滚动）">
          {regular.map((p) => (
            <li class:list={['plan card', { featured: p.badge, 'has-cycles': p.cycles }]} data-category={p.category}>
              <div class="plan-top">
                <span class="plan-cat">{p.categoryLabel}</span>
                {p.badge && <span class="plan-badge">{p.badge}</span>}
              </div>
              <h3 class="plan-name">{p.name}{p.sub && <small>{p.sub}</small>}</h3>
              <p class="plan-price"><span class="cur">¥</span><span class="num">{p.price}</span><span class="bill">{p.billing}</span></p>
              <p class="plan-traffic">{p.category === 'onetime' ? `${p.traffic} 总流量` : p.traffic}</p>
              {p.cycles ? (
                <table class="cycles">
                  <caption class="sr-only">{p.name} 四个付款周期的价格</caption>
                  <thead><tr><th scope="col">付款周期</th><th scope="col">价格</th><th scope="col">折合每月</th></tr></thead>
                  <tbody>
                    {p.cycles.map((c) => (
                      <tr class:list={{ best: c.months === 12 }}>
                        <th scope="row">{c.label}{c.off && <span class="off">{c.off}</span>}</th>
                        <td class="c-total">¥{yuan(c.price)}</td>
                        <td class="c-month">¥{yuan(perMonth(c))}<small>/月</small></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              ) : null}
              <p class="plan-hint">{p.cycles ? `年付最省：比按月付一年省 ¥${yuan(saving(p, p.cycles[p.cycles.length - 1]))}` : p.hint}</p>
              <a class:list={['btn', p.badge ? 'btn-primary' : 'btn-outline', 'plan-btn']} href={SITE.registerUrl} target="_blank" rel="noopener" aria-label={`选择此套餐：${p.name}`}>选择此套餐</a>
            </li>
          ))}
        </ul>
        <div class="rail-track" aria-hidden="true"><span class="rail-thumb" data-rail-thumb></span></div>
      </div>

      <div class="plan card plan-custom" data-category="custom" data-plan-custom>
        <svg class="pc-orbit" viewBox="0 0 600 260" aria-hidden="true" focusable="false">
          <ellipse cx="420" cy="150" rx="300" ry="70" transform="rotate(-10 420 150)" />
          <ellipse cx="420" cy="150" rx="210" ry="46" transform="rotate(-10 420 150)" />
        </svg>
        <div class="pc-main">
          <div class="plan-top"><span class="plan-cat">{custom.categoryLabel}</span></div>
          <h3 class="plan-name">{custom.name}</h3>
          <p class="plan-hint">{custom.hint}</p>
        </div>
        <div class="pc-price">
          <p class="plan-price"><span class="cur">¥</span><span class="num">{custom.price}</span><span class="bill">{custom.billing}</span></p>
          <p class="plan-traffic">{custom.traffic}</p>
        </div>
        <div class="pc-actions">
          <a class="btn btn-primary plan-btn" href={SITE.registerUrl} target="_blank" rel="noopener" aria-label={`选择此套餐：${custom.name}`}>选择此套餐</a>
          <a class="pc-more" href="/guides/plan-selection/#custom">定制套餐说明<Icon name="arrow" size={16} /></a>
        </div>
      </div>
      <div class="plan-foot">
        <p class="plan-note">{PLAN_NOTE}</p>
        <div class="plan-links">
          <a href="/guides/plan-selection/">完整价格表与计费规则<Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 服务说明：9 档套餐共用的规则 -->
  <section class="section about" id="service" aria-labelledby="service-title">
    <div class="container about-grid">
      <div class="about-copy">
        <span class="eyebrow">服务说明</span>
        <h2 id="service-title">9 档套餐共用的服务规则</h2>
        <p>无论选月付、年付、流量包还是私人定制，以下规则都相同：<strong>不限速</strong>、按 <strong>1.0 倍率</strong>计费、<strong>不限设备数量</strong>，协议、线路与节点地区也一致。至尊私人定制在此基础上另配独立带宽和专属公网 IP，不与其他用户共享。</p>
        <p>售后通过用户中心工单处理，所有套餐使用相同的售后渠道。</p>
        <a class="about-link" href="/guides/plan-selection/">逐档查看计费规则、线路与节点<Icon name="arrow" size={16} /></a>
      </div>
      <dl class="about-facts card">
        {COMMON_FACTS.map((f) => (
          <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <!-- FAQ：品牌层面的问题 -->
  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="container faq-grid">
      <div class="section-head">
        <span class="eyebrow">FAQ</span>
        <h2 id="faq-title">常见问题</h2>
        <p>关于官网、注册、价格、设备与售后的简要回答，详细规则见套餐价格与服务说明。</p>
      </div>
      <div class="faq-list">
        {FAQS.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary><h3>{f.q}</h3><span class="faq-icon" aria-hidden="true"><Icon name="plus" size={18} /></span></summary>
            <div class="faq-a">
              <p>{f.a}</p>
              {f.link && <a class="faq-link" href={f.link.href} {...ext(f.link.external)}>{f.link.text}<Icon name="arrow" size={16} /></a>}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  // 套餐筛选 + 横向滚动（左右箭头、进度条、两侧渐隐）
  const group = document.querySelector<HTMLElement>('[data-plan-filter]');
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const grid = document.querySelector<HTMLElement>('[data-plan-grid]');
  const cards = document.querySelectorAll<HTMLElement>('[data-plan-grid] > li');
  const customCard = document.querySelector<HTMLElement>('[data-plan-custom]');
  const status = document.querySelector<HTMLElement>('[data-plan-status]');
  const prev = document.querySelector<HTMLButtonElement>('[data-rail-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-rail-next]');
  const thumb = document.querySelector<HTMLElement>('[data-rail-thumb]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  let raf = 0;
  const update = () => {
    raf = 0;
    if (!grid || !rail) return;
    const max = grid.scrollWidth - grid.clientWidth;
    const x = grid.scrollLeft;
    const scrollable = max > 2;
    rail.classList.toggle('is-scrollable', scrollable);
    grid.classList.toggle('fade-l', scrollable && x > 2);
    grid.classList.toggle('fade-r', scrollable && x < max - 2);
    if (prev) prev.disabled = !scrollable || x <= 2;
    if (next) next.disabled = !scrollable || x >= max - 2;
    if (thumb && scrollable) {
      const ratio = grid.clientWidth / grid.scrollWidth;
      thumb.style.width = `${ratio * 100}%`;
      thumb.style.transform = `translateX(${(x / grid.scrollWidth / ratio) * 100}%)`;
    }
  };
  const schedule = () => { if (!raf) raf = requestAnimationFrame(update); };
  const step = (dir: number) => {
    if (!grid) return;
    const first = Array.from(cards).find((c) => !c.hidden);
    const gap = parseFloat(getComputedStyle(grid).columnGap) || 0;
    const card = first ? first.getBoundingClientRect().width + gap : grid.clientWidth;
    const perView = Math.max(1, Math.floor((grid.clientWidth + gap) / card));
    grid.scrollBy({ left: dir * perView * card, behavior: reduce.matches ? 'auto' : 'smooth' });
  };
  prev?.addEventListener('click', () => step(-1));
  next?.addEventListener('click', () => step(1));
  grid?.addEventListener('scroll', schedule, { passive: true });
  if (grid && 'ResizeObserver' in window) new ResizeObserver(schedule).observe(grid);
  window.addEventListener('load', schedule);
  update();

  if (group) {
    group.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
      if (!btn) return;
      const key = btn.dataset.filter;
      group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let n = 0;
      cards.forEach((c) => {
        const show = key === 'all' || c.dataset.category === key;
        c.hidden = !show;
        if (show) n++;
      });
      const showCustom = key === 'all' || key === 'custom';
      if (customCard) customCard.hidden = !showCustom;
      if (rail) rail.hidden = n === 0;
      if (grid) grid.scrollLeft = 0;
      update();
      if (status) status.textContent = `${btn.textContent}：共 ${n + (showCustom ? 1 : 0)} 档套餐`;
    });
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; overflow: hidden; isolation: isolate; padding-top: 56px; }
  .hero-sky {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(760px 520px at 76% 44%, rgba(124, 58, 237, 0.2), rgba(124, 58, 237, 0) 70%),
      radial-gradient(640px 360px at 8% -8%, rgba(109, 40, 217, 0.12), rgba(109, 40, 217, 0) 70%),
      linear-gradient(180deg, #08060f 0%, var(--bg) 100%);
  }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 11fr) minmax(0, 12fr); align-items: center; gap: 24px; }
  .hero-copy { position: relative; z-index: 1; padding: 32px 0 64px; }
  /* Hero 换成紫色 logo 后，小标题跟着用淡紫 */
  .hero-kicker { display: inline-flex; align-items: center; gap: 12px; font-size: 13px; font-weight: 600; line-height: 1.4; letter-spacing: 0.24em; color: #c4b5fd; }
  .hero-kicker .dot {
    width: 6px; height: 6px; border-radius: 50%; background: #c4b5fd;
    box-shadow: 0 0 0 3px rgba(196, 181, 253, 0.16), 0 0 12px 2px rgba(196, 181, 253, 0.6);
  }
  /* 标题上方给紫焰留出空间 */
  .hero h1 { margin-top: clamp(30px, 3.4vw, 46px); }
  .h1-name { display: block; font-size: var(--fs-display); line-height: 1.04; font-weight: 600; letter-spacing: 0.03em; color: #f6f2fd; }
  .h1-tag { display: block; margin-top: 20px; font-size: clamp(22px, 2.3vw, 30px); font-weight: 400; line-height: 1.35; letter-spacing: 0.1em; color: var(--text-2); }
  .h1-tag .accent { color: inherit; }
  .hero-lead { margin-top: 28px; max-width: 34em; font-size: 16.5px; line-height: 1.9; color: var(--muted); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 40px; }
  .hero-actions .btn { min-height: 52px; padding: 0 28px; font-size: 16px; }
  .hero-visual { position: relative; width: 116%; margin-right: -16%; }

  /* 事实条：五条真实信息，发丝线分隔 */
  .facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .facts li { display: flex; align-items: center; gap: 12px; min-height: 76px; padding: 0 24px; font-size: 15px; font-weight: 500; line-height: 1.4; color: var(--text-2); }
  .facts li:first-child { padding-left: 0; }
  .facts li + li { border-left: 1px solid var(--line); }
  .facts li :global(svg) { flex-shrink: 0; color: var(--accent-hi); }

  /* ---------- Pricing ---------- */
  .pricing-top { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px 48px; flex-wrap: wrap; margin-bottom: 40px; }
  .pricing-top .section-head { margin-bottom: 0; }
  .plan-filter { display: inline-flex; gap: 4px; padding: 4px; border: 1px solid var(--line); border-radius: var(--r-sm); background: rgba(7, 5, 15, 0.6); }
  .filter-btn {
    min-height: 44px; padding: 0 18px; border-radius: var(--r-xs); border: 1px solid transparent; background: transparent; color: var(--muted);
    font: inherit; font-size: 14.5px; font-weight: 500; line-height: 1; white-space: nowrap; cursor: pointer;
    transition: color .2s var(--ease), background-color .2s var(--ease), border-color .2s var(--ease);
  }
  .filter-btn:hover { color: var(--text); background: rgba(167, 139, 250, 0.06); }
  .filter-btn[aria-pressed='true'] { color: #fff; background: rgba(139, 92, 246, 0.18); border-color: var(--accent-line); }

  /* 横向滚动的套餐卡片：手机露出下一张的边，电脑约 3.5 张一屏 */
  .rail { position: relative; }
  .rail[hidden] { display: none !important; }
  .rail-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px; }
  .rail-hint { display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--muted); }
  .rail-hint::before { content: ''; width: 18px; height: 1px; background: var(--accent-hi); opacity: .6; }
  .rail-hint-mouse { display: none; }
  @media (hover: hover) and (pointer: fine) { .rail-hint-touch { display: none; } .rail-hint-mouse { display: inline; } }
  .rail:not(.is-scrollable) .rail-bar { visibility: hidden; }
  .rail-nav { display: flex; gap: 8px; }
  .rail-btn {
    display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0;
    border-radius: 50%; border: 1px solid var(--line-2); background: rgba(17, 12, 32, 0.7); color: var(--text); cursor: pointer;
    transition: border-color .2s var(--ease), background-color .2s var(--ease), color .2s var(--ease), opacity .2s var(--ease);
  }
  .rail-btn svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .rail-btn:hover:not(:disabled) { border-color: var(--accent-line); background: rgba(139, 92, 246, 0.16); color: #fff; }
  .rail-btn:disabled { opacity: .35; cursor: default; }
  .rail-btn:focus-visible { outline: 2px solid var(--accent-hi); outline-offset: 2px; }

  .plan-grid {
    list-style: none; margin: 0; padding: 2px 2px 6px;
    display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 60px) / 3.5); gap: 20px; align-items: stretch;
    overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: 2px;
    scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .plan-grid::-webkit-scrollbar { display: none; }
  .plan-grid:focus-visible { outline: 2px solid var(--accent-hi); outline-offset: 4px; border-radius: var(--r); }
  .plan-grid.fade-r { -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 56px), transparent); mask-image: linear-gradient(90deg, #000 calc(100% - 56px), transparent); }
  .plan-grid.fade-l { -webkit-mask-image: linear-gradient(90deg, transparent, #000 56px); mask-image: linear-gradient(90deg, transparent, #000 56px); }
  .plan-grid.fade-l.fade-r { -webkit-mask-image: linear-gradient(90deg, transparent, #000 56px, #000 calc(100% - 56px), transparent); mask-image: linear-gradient(90deg, transparent, #000 56px, #000 calc(100% - 56px), transparent); }
  .plan-grid > li { scroll-snap-align: start; min-width: 0; }
  .rail-track { position: relative; height: 2px; margin-top: 18px; border-radius: 2px; background: var(--line); overflow: hidden; }
  .rail:not(.is-scrollable) .rail-track { visibility: hidden; }
  .rail-thumb { position: absolute; left: 0; top: 0; bottom: 0; width: 30%; border-radius: 2px; background: var(--accent-hi); }
  .plan { position: relative; display: flex; flex-direction: column; padding: 28px 24px 24px; transition: border-color .25s var(--ease), background-color .25s var(--ease); }
  /* 筛选隐藏的卡片：必须压过各断点里的 display 设置 */
  .plan[hidden] { display: none !important; }
  .plan:hover { border-color: var(--line-2); }
  .plan.featured {
    border-color: var(--accent-line);
    background:
      radial-gradient(120% 60% at 50% 0%, rgba(139, 92, 246, 0.22), rgba(139, 92, 246, 0) 70%),
      linear-gradient(180deg, rgba(22, 15, 43, 0.92), rgba(17, 12, 32, 0.92));
  }
  .plan.featured::before {
    content: ''; position: absolute; left: 24px; right: 24px; top: -1px; height: 1px;
    background: linear-gradient(90deg, rgba(196, 181, 253, 0), var(--accent-hi), rgba(196, 181, 253, 0));
  }
  .plan-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; min-height: 24px; }
  .plan-cat { font-size: 13px; font-weight: 500; letter-spacing: 0.04em; color: var(--muted); }
  .plan-badge {
    font-size: 12px; font-weight: 600; line-height: 1.6; color: #fff; background: var(--accent-fill); padding: 1px 10px; border-radius: var(--r-xs);
    box-shadow: 0 0 18px -4px rgba(139, 92, 246, 0.9);
  }
  .plan-name { margin-top: 16px; font-size: 19px; font-weight: 600; letter-spacing: 0.02em; line-height: 1.4; }
  .plan-name small { margin-left: 8px; font-size: 13px; font-weight: 500; letter-spacing: 0; color: var(--muted); }
  .plan-price { display: flex; align-items: baseline; margin-top: 20px; font-variant-numeric: tabular-nums; }
  .plan-price .cur { align-self: flex-start; margin: 4px 4px 0 0; font-size: 20px; font-weight: 500; line-height: 1; color: var(--accent-hi); }
